#!/usr/bin/env bash
set -euo pipefail

echo "==> [pre-push] fmt check..."
cargo fmt --all -- --check

echo "==> [pre-push] clippy..."
cargo clippy --all-targets --all-features -- -D warnings

echo "==> [pre-push] build..."
cargo build --release --quiet

echo "==> [pre-push] tests..."
cargo test --quiet

echo "==> [pre-push] all checks passed."
