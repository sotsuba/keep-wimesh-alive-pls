#!/bin/bash
log() { echo "$(date -Iseconds) $*" >> "$LOGFILE"; }
readonly IFACE="$1" EVENT="$2" BINARY="/usr/local/bin/keep_wimesh_session"
readonly LOGFILE="/var/log/wimesh_login.log" LOCKFILE="/tmp/wimesh_${IFACE}.lock"

[[ "$CONNECTION_TYPE" == "802-11-wireless" ]] || exit 0
[[ "$EVENT" =~ ^(up|connectivity-change)$ ]] || exit 0
[[ "$EVENT" == "connectivity-change" && "$CONNECTIVITY_STATE" != @(portal|limited|none) ]] && exit 0
if [[ -f "$LOCKFILE" ]] && { read PID < "$LOCKFILE" 2>/dev/null; kill -0 "$PID" 2>/dev/null; }; then
  log "already running (pid $PID), skipping"; exit 0
fi

rm -f "$LOCKFILE"
echo $$ > "$LOCKFILE"
trap 'rm -f "$LOCKFILE"' EXIT
log "event=$EVENT iface=$IFACE ssid=$CONNECTION_ID connectivity=${CONNECTIVITY_STATE:-?}"
"$BINARY" "$SSID" >> "$LOGFILE" 2>&1
log "binary exited with status $?"